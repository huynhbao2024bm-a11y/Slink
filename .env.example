NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
# Demo only: set true to let store owners sign up and enter without email verification.
DEMO_DISABLE_EMAIL_VERIFICATION=true
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_TOKEN=
# Example: Slink <no-reply@your-verified-domain>
EMAIL_FROM=
# Optional shortcut if using Resend without specifying EMAIL_DELIVERY_URL
RESEND_API_KEY=
APP_DATABASE_URL=postgresql://slink_app:CHANGE_ME@127.0.0.1:5433/slink
MIGRATION_DATABASE_URL=postgresql://slink_migrator:CHANGE_ME@127.0.0.1:5433/slink
# Local development only. Production must set PG_SSL=true.
PG_SSL=false
DB_POOL_MAX=10
TRUSTED_PROXY_IPS=
# Use TRUSTED_PROXY_HOPS only when deployed behind a known fixed number of trusted reverse proxies.
TRUSTED_PROXY_HOPS=
LOG_LEVEL=info

# --- Commercial Partner Integrations (leave blank until partner credentials are issued) ---

# 1. Bank Transfer Auto-Reconciliation Webhooks (Gach no tu dong)
SEPAY_WEBHOOK_TOKEN=
CASSO_SECURE_TOKEN=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# 2. E-Wallets & Cards (MoMo / VNPAY)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_ENDPOINT=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# 3. E-Invoice NĐ 123/2020 & NĐ 70/2025 (Hoa don dien tu)
MISA_EINVOICE_URL=
MISA_APP_ID=
MISA_SECRET=
VIETTEL_EINVOICE_URL=
VIETTEL_EINVOICE_USER=
VIETTEL_EINVOICE_PASS=

# 4. Shipping Partners (Van chuyen)
GHN_TOKEN=
GHN_SHOP_ID=
GHN_ENDPOINT=https://online-gateway.ghn.vn/shiip/public-api/v2/shipping-order/create
GHTK_TOKEN=
GHTK_ENDPOINT=https://services.giaohangtietkiem.vn/services/shipment/order
VTP_TOKEN=

# 5. E-Commerce Marketplaces (San TMDT)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=

# 6. Zalo ZNS & Error Monitoring
ZALO_OA_ACCESS_TOKEN=
ZALO_ZNS_TEMPLATE_ID=
SENTRY_DSN=
