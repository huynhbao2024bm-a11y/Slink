#!/bin/bash
set -euo pipefail

exec > >(tee -a /var/log/slink-bootstrap.log | logger -t slink-bootstrap -s 2>/dev/console) 2>&1

if ! mountpoint -q /var/lib/slink; then
  device=/dev/disk/by-id/google-slink-data
  if [ ! -e "$device" ]; then
    echo "Persistent Slink data disk is missing: $device" >&2
    exit 1
  fi
  if ! blkid "$device" >/dev/null 2>&1; then
    mkfs.ext4 -F "$device"
  fi
  disk_uuid="$(blkid -s UUID -o value "$device")"
  mkdir -p /var/lib/slink
  grep -q "$disk_uuid" /etc/fstab || echo "UUID=$disk_uuid /var/lib/slink ext4 defaults,nofail 0 2" >> /etc/fstab
  mount /var/lib/slink
fi

install -d -m 0755 /opt/slink /opt/slink/postgres-init
install -d -m 0700 /etc/slink /etc/slink/secrets /etc/slink/db-tls
install -d -m 0700 /var/lib/slink/postgres /var/lib/slink/backups
install -d -m 0750 /var/lib/slink/caddy-data /var/lib/slink/caddy-config

if ! getent passwd 1000 >/dev/null; then
  useradd --uid 1000 --system --home-dir /nonexistent --shell /usr/sbin/nologin slink
fi
chown 1000:1000 /var/lib/slink/backups
chmod 0700 /var/lib/slink/backups

if ! command -v docker >/dev/null 2>&1 || ! docker compose version >/dev/null 2>&1 || ! command -v gcloud >/dev/null 2>&1; then
  apt-get update
  apt-get install -y ca-certificates curl gnupg openssl python3
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor --yes -o /etc/apt/keyrings/docker.gpg
  chmod a+r /etc/apt/keyrings/docker.gpg
  . /etc/os-release
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $VERSION_CODENAME stable" > /etc/apt/sources.list.d/docker.list
  curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg | gpg --dearmor --yes -o /etc/apt/keyrings/google-cloud.gpg
  chmod a+r /etc/apt/keyrings/google-cloud.gpg
  echo "deb [signed-by=/etc/apt/keyrings/google-cloud.gpg] https://packages.cloud.google.com/apt cloud-sdk main" > /etc/apt/sources.list.d/google-cloud-sdk.list
  apt-get update
  apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin google-cloud-cli
  systemctl enable --now docker
fi

if [ ! -f /opt/slink/.host-bootstrap-installed ]; then
  printf '%s' '${compose_b64}' | base64 -d > /opt/slink/compose.yaml
  printf '%s' '${caddy_b64}' | base64 -d > /opt/slink/Caddyfile
  printf '%s' '${database_init_b64}' | base64 -d > /opt/slink/postgres-init/10-roles.sh
  printf '%s' '${backup_script_b64}' | base64 -d > /opt/slink/backup.sh
  printf '%s' '${backup_service_b64}' | base64 -d > /opt/slink/backup.service
  printf '%s' '${backup_timer_b64}' | base64 -d > /opt/slink/backup.timer
  printf '%s' '${activate_script_b64}' | base64 -d > /opt/slink/activate-host.sh
  printf '%s' '${release_script_b64}' | base64 -d > /opt/slink/deploy-release.sh
  chmod 0644 /opt/slink/compose.yaml /opt/slink/Caddyfile
  chmod 0755 /opt/slink/postgres-init/10-roles.sh /opt/slink/backup.sh
  chmod 0755 /opt/slink/activate-host.sh /opt/slink/deploy-release.sh
  chmod 0644 /opt/slink/backup.service /opt/slink/backup.timer

  cat > /etc/slink/release.env <<'ENV'
SLINK_PROJECT_ID=${project_id}
SLINK_REGION=${region}
SLINK_API_IMAGE=${region}-docker.pkg.dev/${project_id}/slink/slink-api:pending
SLINK_OPS_IMAGE=${region}-docker.pkg.dev/${project_id}/slink/slink-ops:pending
SLINK_DOMAIN=${domain}
SLINK_BACKUP_BUCKET=${backup_bucket}
ENV
  chmod 0600 /etc/slink/release.env
  touch /opt/slink/.host-bootstrap-installed
fi

if [ ! -s /etc/slink/db-tls/server.crt ]; then
  openssl req -x509 -newkey rsa:3072 -sha256 -nodes -days 825 \
    -keyout /etc/slink/db-tls/server.key \
    -out /etc/slink/db-tls/server.crt \
    -subj '/CN=database' -addext 'subjectAltName=DNS:database' \
    -addext 'basicConstraints=critical,CA:TRUE' \
    -addext 'keyUsage=critical,digitalSignature,keyEncipherment,keyCertSign' \
    -addext 'extendedKeyUsage=serverAuth'
  chown root:999 /etc/slink/db-tls/server.key
  chmod 0440 /etc/slink/db-tls/server.key
  chmod 0444 /etc/slink/db-tls/server.crt
fi

gcloud auth configure-docker ${region}-docker.pkg.dev --quiet
echo 'Slink host bootstrap completed. No application container started; add secrets and choose the hostname before activation.'
