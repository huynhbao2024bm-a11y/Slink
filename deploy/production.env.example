# Copy these keys into the hosting provider's secret/environment settings.
# Never commit a populated production environment file.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PUBLIC_ORIGIN=
DEMO_DISABLE_EMAIL_VERIFICATION=false
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_TOKEN=
APP_DATABASE_URL=
MIGRATION_DATABASE_URL=
# For the Supabase Session Pooler on Render, use the bundled public root CA:
PG_SSL=ca-file
PG_SSL_CA_FILE=/opt/render/project/src/deploy/render/supabase-ca.crt
# For providers using a publicly trusted TLS chain, use PG_SSL=true instead.
DB_POOL_MAX=10
TRUSTED_PROXY_IPS=
LOG_LEVEL=info
