# Copy these keys into the hosting provider's secret/environment settings.
# Never commit a populated production environment file.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PUBLIC_ORIGIN=
DEMO_DISABLE_EMAIL_VERIFICATION=false
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_TOKEN=
# Sender address on a domain verified with the email provider.
EMAIL_FROM=
APP_DATABASE_URL=
MIGRATION_DATABASE_URL=
# For a direct remote PostgreSQL host, use verified server TLS.
PG_SSL=true
# The GCP Compute Engine Compose profile overrides this with a mounted private CA:
# PG_SSL=ca-file
# PG_SSL_CA_FILE=/run/secrets/database_ca_certificate
DB_POOL_MAX=10
TRUSTED_PROXY_IPS=
LOG_LEVEL=info
